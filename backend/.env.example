# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/courier_hub

# Long random strings. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
WEBHOOK_SECRET=

# Encrypts courier API keys in the database. Generate with: python -m app.scripts.set_api_key --new-encryption-key
# Keep it safe: changing it makes the stored keys unreadable.
CREDENTIALS_ENCRYPTION_KEY=

ACCESS_TOKEN_MINUTES=15
# Users are signed out this many hours after signing in, however active they are.
SESSION_HOURS=24
# Set to true when the site runs on HTTPS.
COOKIE_SECURE=false
STORAGE_DIR=storage
TRACKING_POLL_MINUTES=30
